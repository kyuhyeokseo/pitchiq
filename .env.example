# Copy to .env (never commit .env). The offline app needs none of these.
# LLM_MODE=offline uses the deterministic plans only; foundry also asks the Foundry Analyst -> Producer agents.
LLM_MODE=offline
# Your real Foundry project endpoint and deployed model name. Do not invent values.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
# Live Analyst -> Producer runs started per UTC day (0 = no cap). Cached plans do not count; beyond the cap the
# deterministic plan stays. Set a cap on a public deployment so visitors cannot spend the subscription's credit.
FOUNDRY_DAILY_LIMIT=100
# Reasoning effort sent to reasoning models: minimal keeps gpt-5-mini inside the stage timeouts (use none or low for
# models without minimal). Leave empty for models that reject the option.
FOUNDRY_REASONING_EFFORT=minimal
# azure_cli for local work (az login), managed_identity on Azure.
AUTH_MODE=azure_cli
# Host names the MCP endpoint (/mcp) answers besides 127.0.0.1 and localhost: comma-separated, no scheme, such as the
# Container App's ingress FQDN. Any other Host header gets 421 (DNS-rebinding protection stays on); a browser Origin
# must be https on one of these hosts. Read when the app starts.
PITCHIQ_PUBLIC_HOSTS=
